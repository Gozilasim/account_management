# Created at: 2026-05-11 01:39
# Updated at: 2026-10-11 11:27
# Description: Example root environment variables for the backend Portal service and app launcher.

# Local default uses SQLite at project-root data/portal.db.
# Docker compose overrides this to sqlite:////app/data/portal.db inside the container.
DATABASE_URL=sqlite:///./data/portal.db

# Backend reads this root .env even when commands are run from backend/.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Public URLs are optional. If empty, they are derived from host/port above.
# Set these explicitly in production or when using a custom domain.
BACKEND_URL=
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_URL=
CORS_ORIGINS=

SESSION_COOKIE_NAME=portal_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_MINUTES=10080
TRUST_PROXY_HEADERS=false

MFA_ISSUER=My Portal
PASSWORD_MIN_LENGTH=8
# email sends the reset link through SMTP. dev_log only writes it to the server log, and hands it
# back to the browser when the frontend is served from localhost.
PASSWORD_RESET_DELIVERY=dev_log
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Repeated failed sign-ins for one account or one IP address lock sign-in for a while.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Outgoing email (password reset links and new sign-in alerts). Leave SMTP_HOST empty to turn email off.
# SMTP_SECURITY is starttls (usually port 587), ssl (usually port 465), or none.
PRODUCT_NAME=GozilaSim ID
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
EMAIL_FROM=
AVATAR_MAX_BYTES=5242880

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production should provide a stable RSA private key.
# OIDC_PRIVATE_KEY_PEM=
# OIDC_PRIVATE_KEY_PATH=
OIDC_KEY_ID=portal-dev-key
OIDC_CLIENTS_JSON=[{"client_id":"media-editor-dev","name":"Media Editor","home_url":"http://localhost:3000","launch_url":"http://localhost:3000/auth/portal/start","icon_url":"/app-icons/media-editor.png","redirect_uris":["http://localhost:3000/auth/callback"],"allowed_scopes":["openid","email","profile","phone"],"public":true,"launcher_visible":true},{"client_id":"group-chat-dev","name":"Group Chat","home_url":"http://localhost:3000","launch_url":"http://localhost:3000/auth/portal/start","icon_url":"/app-icons/group-chat.png","redirect_uris":["http://localhost:3000/auth/callback"],"allowed_scopes":["openid","email","profile","phone"],"public":true,"launcher_visible":true}]
